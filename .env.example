# ── Supabase ────────────────────────────────────────────────────────────────
# URL base del proyecto Supabase (SIN /rest/v1/ al final)
# Ej: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública (anon) — expuesta al cliente, segura con RLS activo
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave de servicio — SOLO en el servidor, bypasea RLS
# Necesaria si las políticas RLS bloquean la lectura de password_hash
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Autenticación del administrador ─────────────────────────────────────────
# Contraseña para acceder al panel de administración (/admin)
ADMIN_PASSWORD=contraseña-segura-aqui

# ── Email — Resend ───────────────────────────────────────────────────────────
# API key de Resend (resend.com → API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dirección "From" para los emails enviados por el sistema
# Debe ser un dominio verificado en Resend
EMAIL_FROM=vacaciones@lasalle.edu.ar

# ── App ──────────────────────────────────────────────────────────────────────
# URL pública de la app (sin barra final)
# En desarrollo: http://localhost:3000
# En producción: https://vacaciones.lasalle.org.ar
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL del formulario de Google Forms para solicitar vacaciones
# Se incrusta como iframe en el modal de solicitud
NEXT_PUBLIC_GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/xxxxx/viewform?embedded=true
